.{
    .id = "dev.native_sdk.sarvam-translate",
    .name = "sarvam-translate",
    .display_name = "Sarvam Translate",
    .description = "A compact native menu-bar translator powered by Sarvam AI.",
    .version = "0.1.0",
    .icons = .{"assets/sarvam-logo.png"},
    .platforms = .{"macos"},
    .permissions = .{ "view", "command", "credentials" },
    .capabilities = .{ "native_views", "gpu_surfaces", "tray" },
    .shell = .{
        .windows = .{
            .{
                .label = "main",
                .title = "Sarvam Translate",
                .width = 460,
                .height = 720,
                .min_width = 420,
                .min_height = 560,
                .restore_state = false,
                .restore_policy = "center_on_primary",
                .close_policy = "hide",
                .views = .{
                    .{ .label = "main-canvas", .kind = "gpu_surface", .fill = true, .role = "Sarvam translator widget", .accessibility_label = "Sarvam Translate", .gpu_backend = "metal", .gpu_pixel_format = "bgra8_unorm", .gpu_present_mode = "timer", .gpu_alpha_mode = "opaque", .gpu_color_space = "srgb", .gpu_vsync = true },
                },
            },
        },
    },
    .security = .{
        .navigation = .{
            .allowed_origins = .{ "zero://app", "zero://inline" },
            .external_links = .{ .action = "deny" },
        },
    },
    .web_engine = "system",
    .cef = .{ .dir = "third_party/cef/macos", .auto_install = false },
}
