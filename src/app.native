<column gap="12" padding="16">
  <if test="{not configured}">
    <column gap="16" grow="1" main="center">
      <column gap="4">
        <text size="display">Welcome to Sarvam Translate</text>
        <text foreground="text_muted" wrap="true">Add your Sarvam API key to start translating natural Indian language with Mayura.</text>
      </column>

      <if test="{checkingKey}">
        <card background="surface" radius="lg">
          <row gap="8" padding="14" cross="center">
            <spinner />
            <text>Checking secure Keychain storage...</text>
          </row>
        </card>
      </if>
      <else>
      <card background="surface" radius="lg">
        <column gap="10" padding="14">
          <text>Connect Sarvam AI</text>
          <text-field text="{apiKeyText}" placeholder="Paste your api-subscription-key" on-input="api_key_edit" autofocus="true" />
          <text foreground="text_muted" wrap="true">The key is saved securely in your macOS Keychain. It is never written to this app or included in its build.</text>
          <if test="{failed}">
            <text foreground="destructive">Enter an API key to continue.</text>
          </if>
          <if test="{savingKey}">
            <button variant="primary" disabled="true">Saving securely...</button>
          </if>
          <else>
            <button variant="primary" on-press="configure_api_key">Continue</button>
          </else>
        </column>
      </card>
      </else>
    </column>
  </if>
  <else>
    <row cross="center">
      <column grow="1" gap="2">
        <text size="heading">Sarvam Translate</text>
        <text foreground="text_muted">Real Indian language, in your voice</text>
      </column>
      <badge>mayura:v1</badge>
      <button size="sm" variant="ghost" on-press="change_api_key">Key</button>
    </row>

    <column gap="6">
      <text foreground="text_muted">Translate to</text>
      <button-group gap="6">
        <button selected="{targetLabel == 'Hindi'}" on-press="set_hindi">Hindi</button>
        <button selected="{targetLabel == 'Tamil'}" on-press="set_tamil">Tamil</button>
        <button selected="{targetLabel == 'Telugu'}" on-press="set_telugu">Telugu</button>
        <button selected="{targetLabel == 'English'}" on-press="set_english">English</button>
      </button-group>
    </column>

    <column gap="6">
      <text foreground="text_muted">Your text</text>
      <textarea text="{inputText}" placeholder="Type it how you would say it..." on-input="input_edit" height="128" />
    </column>

    <column gap="6">
      <text foreground="text_muted">Tone</text>
      <button-group gap="6">
        <button selected="{tone == 'formal'}" on-press="set_formal">Formal</button>
        <button selected="{tone == 'modern'}" on-press="set_modern">Modern</button>
        <button selected="{tone == 'classic'}" on-press="set_classic">Classic</button>
        <button selected="{tone == 'code_mixed'}" on-press="set_code_mixed">Code mixed</button>
      </button-group>
    </column>

    <row gap="8" cross="center">
      <text foreground="text_muted" grow="1">Numerals</text>
      <button selected="{nativeNumerals}" on-press="set_native_numerals">Native</button>
      <button selected="{not nativeNumerals}" on-press="set_international_numerals">International</button>
    </row>

    <button variant="primary" on-press="translate">Translate to {targetLabel}</button>

    <card background="surface" radius="lg">
      <column gap="8" padding="12">
        <text foreground="text_muted">{status}</text>
        <text wrap="true">{output}</text>
      </column>
    </card>
  </else>
</column>
